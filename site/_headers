# Cloudflare Pages response headers. See SECURITY.md for the reasoning behind each rule.
# The script-src hash allows exactly one inline script (the no-JS/JS class swap in
# src/partials/head.html). If that script changes, recompute the hash:
#   printf '%s' 'document.documentElement.className="js"' | openssl dgst -sha256 -binary | base64

/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-cvlem2Rlcb+inScVb7910PMAU98gRDEfAIUVUKXOWd4='; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; connect-src 'self' https://formsubmit.co; form-action 'self' https://formsubmit.co; frame-src https://formsubmit.co; base-uri 'self'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Every /assets/ URL in the HTML carries ?v=<content hash> (added by tools/build.py),
# so a changed file always gets a new URL and these can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon*
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/web-app-manifest-*
  Cache-Control: public, max-age=604800
